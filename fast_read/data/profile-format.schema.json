{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://innolab.mn/fast_read/data/profile-format.schema.json",
  "title":"fast_read portable profiles v1",
  "type":"object",
  "required":["format","schemaVersion","profiles"],
  "properties":{
    "format":{"const":"fast-read-profiles"},
    "schemaVersion":{"const":1},
    "exportedAt":{"type":"string","format":"date-time"},
    "activeProfileId":{"type":"string"},
    "profiles":{
      "type":"array","minItems":1,"maxItems":50,
      "items":{
        "type":"object",
        "required":["id","name","avatar","createdAt","updatedAt","games"],
        "properties":{
          "id":{"type":"string","pattern":"^[a-zA-Z0-9_-]{1,100}$"},
          "name":{"type":"string","minLength":1,"maxLength":40},
          "avatar":{"type":"string","maxLength":40},
          "createdAt":{"type":"string","format":"date-time"},
          "updatedAt":{"type":"string","format":"date-time"},
          "games":{
            "type":"object",
            "additionalProperties":{
              "type":"object","required":["version","state"],
              "properties":{"version":{"type":"integer","minimum":1},"state":{"type":"object"}},
              "additionalProperties":true
            }
          }
        },
        "additionalProperties":true
      }
    }
  },
  "additionalProperties":true
}
