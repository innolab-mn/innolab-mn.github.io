CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=
CONTENTFUL_REVALIDATE_SECRET=
NEXT_PUBLIC_PREVIEW=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public Supabase project values (never use a secret/service-role key here).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true only after completing docs/supabase-setup.md.
NEXT_PUBLIC_MEMBERSHIP_ENABLED=false
# Public site key only; the private Turnstile secret belongs in Supabase.
# Deploy the widget and updated username-login before enabling CAPTCHA in Supabase.
NEXT_PUBLIC_CAPTCHA_ENABLED=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# false hides CAPTCHA on login/register/password reset. Also disable the CAPTCHA
# requirement in Supabase Auth; this frontend flag cannot override server security.
# Restart dev / rebuild and redeploy after changing NEXT_PUBLIC values.

# Public bank-transfer instructions; these are visible in the static browser build.
# Restart dev / rebuild and redeploy after editing.
NEXT_PUBLIC_SHOP_BANK_NAME=
NEXT_PUBLIC_SHOP_BANK_ACCOUNT=
NEXT_PUBLIC_SHOP_BANK_HOLDER=

# Optional static event decoration. Empty = none. Rebuild after changing.
EVENT_DECORATION=
